# Google OAuth Configuration
# Get these values from Google Cloud Console: https://console.cloud.google.com/
REACT_APP_GOOGLE_CLIENT_ID=your-google-client-id-here
REACT_APP_GOOGLE_API_KEY=your-google-api-key-here

# Optional: Google Sheets API configuration
REACT_APP_GOOGLE_SHEETS_API_KEY=your-sheets-api-key-here
